<UserControl x:Class="BottleneckHunter.Views.Sensors.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BottleneckHunter.Controls"
             xmlns:local="clr-namespace:BottleneckHunter.Views.Sensors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- Caixa de busca com lupa e texto de exemplo -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" Padding="12,0,34,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="13"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Grid>
                                    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextDim}"
                                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão só com ícone (limpar busca, desafixar) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Width="26" Height="26" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estrela de fixar: acende e dá um "pulo" ao clicar -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Content" Value="&#xE734;"/>
            <Setter Property="ToolTip" Value="Fixar no topo da página"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Width="26" Height="26" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Content" Value="&#xE735;"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="ToolTip" Value="Desafixar"/>
                </DataTrigger>
                <EventTrigger RoutedEvent="ButtonBase.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.4" Duration="0:0:0.12" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1" To="1.4" Duration="0:0:0.12" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cartão de peça: sem o "pulo" do Card comum, porque é grande -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>

        <!-- Etiqueta colorida com o tipo da peça (CPU, GPU...) -->
        <DataTemplate x:Key="KindBadge">
            <Grid VerticalAlignment="Center">
                <Border CornerRadius="6" Opacity="0.18" local:ThemeBrush.Key="{Binding KindKey}"/>
                <TextBlock Text="{Binding KindText}" FontSize="10.5" FontWeight="Bold" Margin="8,3"
                           local:ThemeBrush.Key="{Binding KindKey}"/>
            </Grid>
        </DataTemplate>

        <!-- Uma linha de sensor -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:SensorRow}">
            <Border x:Name="RowBg" CornerRadius="8" Padding="4,4,8,4" Background="Transparent" Cursor="Hand"
                    Visibility="{Binding IsVisible, Converter={StaticResource Vis}}"
                    MouseLeftButtonUp="OnRowClick" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource StarButton}" Click="OnStarClick" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <local:LevelBar Grid.Column="2" Height="6" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Fraction="{Binding Fraction}" BrushKey="{Binding BarKey}"/>
                    <TextBlock Grid.Column="3" Text="{Binding ValueText}" Style="{StaticResource Num}" FontWeight="SemiBold"
                               local:ThemeBrush.Key="{Binding ValueKey}"/>
                    <TextBlock Grid.Column="4" Text="{Binding MinText}" Style="{StaticResource Num}"/>
                    <TextBlock Grid.Column="5" Text="{Binding MaxText}" Style="{StaticResource Num}"/>
                    <TextBlock Grid.Column="6" Text="{Binding TrendGlyph}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                               local:ThemeBrush.Key="{Binding TrendKey}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowBg" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource CardHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Um bloco de tipo (TEMPERATURA, USO...) dentro da peça -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:SensorSection}">
            <StackPanel Visibility="{Binding HasVisible, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,4" Background="Transparent" ToolTip="{Binding Explanation}" Cursor="Help">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" local:ThemeBrush.Key="{Binding DotKey}"/>
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="8,0,0,0"/>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextDim}"
                               Opacity="0.7" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Cartão de uma peça, que abre e fecha com animação -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:HardwareGroup}">
            <Border Style="{StaticResource GroupCard}" Visibility="{Binding HasVisible, Converter={StaticResource Vis}}" Loaded="OnGroupLoaded">
                <StackPanel>
                    <Border x:Name="Header" Background="Transparent" CornerRadius="14" Padding="18,14" Cursor="Hand"
                            MouseLeftButtonUp="OnGroupHeaderClick" ToolTip="Clique para abrir ou fechar">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="12"
                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="14,0,0,0">
                                <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Num}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"/>
                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource KindBadge}" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="Body" Margin="10,0,10,12">
                        <StackPanel.LayoutTransform><ScaleTransform ScaleY="1"/></StackPanel.LayoutTransform>
                        <Border Height="1" Background="{DynamicResource Border}" Margin="8,0,8,8"/>
                        <Grid Margin="4,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="SENSOR" Style="{StaticResource ColHeader}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="3" Text="AGORA" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="4" Text="MÍN." Style="{StaticResource ColHeader}" ToolTip="Menor valor desde que o app abriu (ou desde que você zerou)."/>
                            <TextBlock Grid.Column="5" Text="MÁX." Style="{StaticResource ColHeader}" ToolTip="Maior valor desde que o app abriu (ou desde que você zerou)."/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Header" Property="Background" Value="{DynamicResource CardHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="LayoutTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="LayoutTransform.(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)" To="-90" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cartão de sensor fixado no topo -->
        <DataTemplate x:Key="PinTemplate" DataType="{x:Type local:SensorRow}">
            <!-- A Grid de fora recebe a animação de entrada; o Card de dentro mantém o "pulo" do hover. -->
            <Grid Loaded="OnPinLoaded">
                <Border Style="{StaticResource Card}" Width="214" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="OnPinClick"
                        ToolTip="Clique para ver o gráfico">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Desafixar"
                                    Click="OnStarClick" Margin="0,-4,-6,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Hardware}" FontSize="11" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"
                                   Typography.NumeralAlignment="Tabular" local:ThemeBrush.Key="{Binding ValueKey}"/>
                        <local:Sparkline Height="34" Values="{Binding Spark}" BrushKey="{Binding BarKey}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideTemplate" DataType="{x:Type local:GuideItem}">
            <Border Width="250" Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" local:ThemeBrush.Key="{Binding DotKey}"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="32,8,18,28">
            <TextBlock Text="Sensores" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Tudo o que as peças do seu PC estão medindo agora: temperaturas, uso, clocks, consumo, ventoinhas e mais. Atualiza a cada segundo."/>

            <Border Style="{StaticResource TipBox}">
                <DockPanel>
                    <Button x:Name="GuideButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="14,8" Margin="14,0,0,0"
                            VerticalAlignment="Center" Click="OnToggleGuide" Content="Entenda as leituras ▾"/>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="Bold">💡 Como usar esta tela</Run>
                        <LineBreak/>
                        <Run>Cada peça do PC tem pequenos sensores que medem calor, velocidade e energia. Clique em um sensor para ver o gráfico dele no destaque. Toque na estrela ☆ para fixar no topo os que você mais acompanha. As colunas Mín. e Máx. guardam o menor e o maior valor desde que o app abriu.</Run>
                    </TextBlock>
                </DockPanel>
            </Border>

            <ItemsControl x:Name="GuidePanel" ItemTemplate="{StaticResource GuideTemplate}" Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Enquanto os sensores não respondem -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot1" Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot2" Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot3" Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="EmptyTitle" Text="Lendo os sensores do PC..." FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Dim}" Margin="0,8,0,0"
                               Text="Na primeira vez pode levar alguns segundos, enquanto o app conversa com cada peça."/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ContentRoot" Visibility="Collapsed">
                <Border x:Name="CpuTempWarning" Style="{StaticResource TipBox}" BorderBrush="{DynamicResource Warn}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="Bold">⚠ A temperatura do processador não apareceu.</Run>
                        <Run>O Windows precisa de um driver extra para liberar esse sensor. Instale o PawnIO (comando: winget install namazso.PawnIO) e abra o app de novo, como administrador.</Run>
                    </TextBlock>
                </Border>

                <!-- Fixados -->
                <TextBlock Text="FIXADOS" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource PinTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="PinnedHint" Style="{StaticResource Dim}" Margin="0,0,0,14"
                           Text="Nada fixado ainda. Toque na estrela ☆ ao lado de um sensor para ele aparecer aqui."/>

                <!-- Destaque: o sensor selecionado com gráfico -->
                <Border x:Name="DetailCard" Style="{StaticResource GroupCard}" Padding="20,18">
                    <Grid x:Name="Detail">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="SENSOR EM DESTAQUE" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource KindBadge}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Hardware}" Style="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Dim}" FontSize="11.5">
                                <Run Text="{Binding TypeTitle, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RawName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource BigValue}" FontSize="38" Margin="0,8,0,4"
                                       Typography.NumeralAlignment="Tabular" local:ThemeBrush.Key="{Binding ValueKey}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel ToolTip="Menor valor desde que o app abriu (ou desde que você zerou).">
                                    <TextBlock Text="MÍNIMO" Style="{StaticResource ColHeader}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding MinText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" ToolTip="Média do período mostrado no gráfico.">
                                    <TextBlock Text="MÉDIA" Style="{StaticResource ColHeader}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="AvgText" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" ToolTip="Maior valor desde que o app abriu (ou desde que você zerou).">
                                    <TextBlock Text="MÁXIMO" Style="{StaticResource ColHeader}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding MaxText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="StatusLine" Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,8,0" local:ThemeBrush.Key="{Binding BarKey}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" FontWeight="SemiBold" MaxWidth="270"/>
                            </StackPanel>
                            <TextBlock x:Name="RangeLine" Text="{Binding RangeHint}" Style="{StaticResource Dim}" FontSize="11.5" Margin="17,0,0,8"/>
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Dim}"/>

                            <Button x:Name="DetailPin" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="OnDetailPin"/>
                        </StackPanel>

                        <DockPanel Grid.Column="1">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="range" Content="1 min" Tag="60" IsChecked="True" Checked="OnRange"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="range" Content="5 min" Tag="300" Checked="OnRange"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="range" Content="15 min" Tag="900" Checked="OnRange" Margin="0"/>
                                </StackPanel>
                                <TextBlock x:Name="ChartTitle" Text="ÚLTIMO MINUTO" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <c:LineChart x:Name="Chart" MinHeight="230"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Barra de ferramentas: busca, filtros e ações -->
                <Grid Margin="0,4,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Buscar sensor ou peça (Ctrl+F)"
                                 TextChanged="OnSearchChanged"/>
                        <Button x:Name="ClearSearch" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Limpar busca (Esc)"
                                HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed" Click="OnClearSearch"/>
                    </Grid>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                                    ToolTip="Mostra só os sensores que estão em faixa de atenção ou perigo (amarelo ou vermelho).">
                            <CheckBox x:Name="AlertsOnly" Style="{StaticResource Switch}" Checked="OnAlertsToggle" Unchecked="OnAlertsToggle"/>
                            <TextBlock Text="Só alertas" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="ExpandButton" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0" Click="OnExpandAll"
                                ToolTip="Abrir ou fechar todos os cartões">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExpandGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ExpandText" Text="Recolher tudo"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0" Click="OnPause"
                                ToolTip="Congela os números na tela para você ler com calma. A leitura continua em segundo plano.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PauseGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE769;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PauseText" Text="Pausar"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0" Click="OnResetMinMax"
                                ToolTip="Começa a contar mínimo e máximo de novo a partir de agora. Útil antes de abrir um jogo ou um teste.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Zerar mín./máx."/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="12,8" Click="OnExport"
                                ToolTip="Salva todos os sensores numa planilha (CSV) que abre no Excel ou no Google Planilhas.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Exportar"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <WrapPanel x:Name="TypeChips" Margin="0,0,14,10"/>

                <DockPanel Margin="2,0,14,12">
                    <TextBlock x:Name="StatusNote" DockPanel.Dock="Right" Style="{StaticResource Dim}" Opacity="0" Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Dim}"/>
                </DockPanel>

                <Border x:Name="NoResults" Style="{StaticResource GroupCard}" Padding="18" Visibility="Collapsed">
                    <TextBlock x:Name="NoResultsText" Style="{StaticResource Body}" Foreground="{DynamicResource TextDim}"/>
                </Border>

                <ItemsControl x:Name="GroupsList" ItemTemplate="{StaticResource GroupTemplate}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
