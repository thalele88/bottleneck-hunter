<UserControl x:Class="BottleneckHunter.Views.Bottleneck.BottleneckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Barra horizontal com preenchimento animado -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="32,8,18,28">
            <TextBlock Text="Caçar gargalos" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Descubra qual peça está segurando o desempenho, em três passos: veja ao vivo, grave uma sessão de jogo e confira a configuração do PC."/>

            <Border Style="{StaticResource TipBox}">
                <TextBlock Style="{StaticResource Body}">
                    <Run FontWeight="Bold">💡 Como o Bottleneck Hunter decide?</Run>
                    <Run>Num jogo, a placa de vídeo deveria trabalhar perto de 100%. Se ela está folgada, alguém está segurando: quase sempre um único núcleo do processador, a memória cheia, a temperatura alta ou um limite de FPS. O app olha tudo isso a cada segundo.</Run>
                </TextBlock>
            </Border>

            <!-- ===== 1. Ao vivo ===== -->
            <TextBlock Text="1 · AGORA" Style="{StaticResource CardTitle}" Margin="2,6,0,8"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ícone com anel pulsante -->
                    <Grid Width="96" Height="96" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Ellipse x:Name="PulseRing" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="IconBg" Margin="12"/>
                        <TextBlock x:Name="LiveIcon" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE9D9;"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LiveTitle" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}" Text="Lendo sensores..."/>
                        <TextBlock x:Name="LiveDetail" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="LiveExplain" Style="{StaticResource Body}" Margin="0,10,20,0"/>
                    </StackPanel>

                    <!-- Barras CPU / núcleo / GPU / VRAM / RAM -->
                    <StackPanel Grid.Column="2" x:Name="Bars" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== 2. Sessão ===== -->
            <TextBlock Text="2 · GRAVAR UMA SESSÃO DE JOGO" Style="{StaticResource CardTitle}" Margin="2,10,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                               Text="Um segundo só não diz muito. Escolha a duração, clique em Gravar e vá jogar normalmente. Quando acabar, volte aqui para ver quanto tempo cada peça limitou o desempenho."/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Dur1" Content="1 min" Style="{StaticResource Segment}" GroupName="dur"/>
                        <RadioButton x:Name="Dur3" Content="3 min" Style="{StaticResource Segment}" GroupName="dur" IsChecked="True"/>
                        <RadioButton x:Name="Dur5" Content="5 min" Style="{StaticResource Segment}" GroupName="dur"/>
                        <RadioButton x:Name="Dur10" Content="10 min" Style="{StaticResource Segment}" GroupName="dur"/>
                        <Button x:Name="RecordBtn" Content="● Gravar" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="OnRecord"/>
                    </StackPanel>

                    <!-- Progresso da gravação -->
                    <StackPanel x:Name="RecordingPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock x:Name="RecordCountdown" DockPanel.Dock="Right" Style="{StaticResource Dim}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource Bad}" VerticalAlignment="Center"/>
                                <TextBlock Text="Gravando... pode ir jogar" Margin="8,0,0,0" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,8,0,0">
                            <Border Style="{StaticResource BarTrack}"/>
                            <Border x:Name="RecordProgress" Style="{StaticResource BarFill}" Background="{DynamicResource Accent}" Height="12">
                                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Resultado -->
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,20,0,0">
                        <TextBlock x:Name="ResultTitle" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultSubtitle" Style="{StaticResource Dim}" Margin="0,4,0,14"/>

                        <!-- Barra empilhada: % do tempo de cada limitador -->
                        <Border CornerRadius="8" ClipToBounds="True" Height="26">
                            <Grid x:Name="StackBar"/>
                        </Border>
                        <WrapPanel x:Name="Legend" Margin="0,10,0,0"/>

                        <UniformGrid x:Name="Stats" Columns="4" Margin="0,16,0,0"/>

                        <TextBlock Text="O QUE FAZER" Style="{StaticResource CardTitle}" Margin="0,18,0,6"/>
                        <StackPanel x:Name="Tips"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 3. Checagem ===== -->
            <TextBlock Text="3 · CHECAGEM DA CONFIGURAÇÃO" Style="{StaticResource CardTitle}" Margin="2,10,0,8"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="CheckBtn" DockPanel.Dock="Right" Content="Verificar meu PC" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OnCheckup"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,16,0" VerticalAlignment="Center"
                               Text="Alguns gargalos não aparecem nos medidores: memória em canal único, XMP desligado, monitor preso em 60 Hz, Windows num HD... Esta checagem procura esses problemas clássicos e explica como resolver cada um."/>
                </DockPanel>
            </Border>
            <StackPanel x:Name="CheckList"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
