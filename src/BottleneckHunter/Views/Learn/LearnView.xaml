                                <RadioButton x:Name="Res1080" Content="1080p" Style="{StaticResource Segment}" GroupName="labres" IsChecked="True" Checked="OnLabChanged"/>
                                <RadioButton x:Name="Res1440" Content="1440p" Style="{StaticResource Segment}" GroupName="labres" Checked="OnLabChanged"/>
                                <RadioButton x:Name="Res4K" Content="4K" Style="{StaticResource Segment}" GroupName="labres" Checked="OnLabChanged"/>
                            </StackPanel>

                            <DockPanel>
                                <CheckBox x:Name="CapSwitch" DockPanel.Dock="Left" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="OnLabChanged" Unchecked="OnLabChanged" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Limitar o FPS em 60" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="Como um V-Sync ou limitador de FPS ligado no jogo." Style="{StaticResource Dim}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

