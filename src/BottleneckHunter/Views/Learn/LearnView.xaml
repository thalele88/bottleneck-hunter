                            <TextBlock Canvas.Left="327" Canvas.Top="56" Text="desenha" Style="{StaticResource ArtLabel}" FontSize="12"/>
                            <TextBlock x:Name="GpuWait" Canvas.Left="294" Canvas.Top="0" Text="⏳ esperando a CPU" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Warn}"/>

