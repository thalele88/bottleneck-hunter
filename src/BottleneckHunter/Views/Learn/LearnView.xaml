                            <DockPanel>
                                <TextBlock x:Name="GpuValue" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource Gpu}"/>
                                <TextBlock Text="Força da GPU" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            </DockPanel>
                            <TextBlock Text="Quantos quadros por segundo a placa de vídeo consegue desenhar em 1080p." Style="{StaticResource Dim}"/>
                            <Slider x:Name="GpuSlider" Style="{StaticResource LabSlider}" Foreground="{DynamicResource Gpu}"
                                    Minimum="20" Maximum="300" Value="110" SmallChange="5" LargeChange="20" Margin="0,4,0,14"
                                    ValueChanged="OnLabChanged"/>

                            <TextBlock Text="Resolução do jogo" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="Mais pixels = mais trabalho para a GPU. Para a CPU quase nada muda." Style="{StaticResource Dim}" Margin="0,0,0,6"/>
