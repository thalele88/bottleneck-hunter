            <!-- ===== Passo a passo ===== -->
            <TextBlock Text="Como achar o seu gargalo em 4 passos" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Um roteiro simples usando as outras páginas do Bottleneck Hunter." Style="{StaticResource SectionHint}"/>
            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="232">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Conheça seu PC" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,10,0,4"/>
                        <TextBlock Text="Veja qual CPU, GPU, quanta RAM e que tipo de disco você tem. Confira se a RAM está em dual channel." Style="{StaticResource Dim}" Height="68"/>
                        <Button Content="Abrir Meu PC →" Tag="system" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNavigate"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Jogue e grave" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,10,0,4"/>
                        <TextBlock Text="Abra o jogo, comece uma sessão em Caçar gargalos e jogue alguns minutos numa parte pesada." Style="{StaticResource Dim}" Height="68"/>
                        <Button Content="Caçar gargalos →" Tag="bottleneck" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNavigate"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Olhe as temperaturas" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,10,0,4"/>
                        <TextBlock Text="Peça quente perde velocidade. Veja o máximo de CPU e GPU na página Sensores." Style="{StaticResource Dim}" Height="68"/>
                        <Button Content="Abrir Sensores →" Tag="sensors" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNavigate"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ajuste e compare" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,10,0,4"/>
                        <TextBlock Text="Aplique as otimizações e rode o benchmark de novo. Número maior = ajuste que valeu a pena." Style="{StaticResource Dim}" Height="68"/>
                        <Button Content="Otimizar o PC →" Tag="optimize" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNavigate"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Quiz ===== -->
            <TextBlock Text="Teste o que você aprendeu" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Oito perguntas rápidas. Errar faz parte: cada resposta vem com a explicação." Style="{StaticResource SectionHint}"/>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="QuizBest" DockPanel.Dock="Right" Style="{StaticResource Dim}"/>
                        <TextBlock x:Name="QuizCounter" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <Grid Height="6" Margin="0,0,0,16">
                        <Border CornerRadius="3" Background="{DynamicResource Track}"/>
                        <Border CornerRadius="3" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="QuizBarScale" ScaleX="0"/></Border.RenderTransform>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="QuizQuestionPanel">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="QuizShift"/></StackPanel.RenderTransform>
                        <TextBlock x:Name="QuizQuestionText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text}" Margin="0,0,0,14"/>
                        <StackPanel x:Name="QuizOptions" MaxWidth="640" HorizontalAlignment="Left"/>
                        <Border x:Name="QuizFeedback" CornerRadius="10" Background="{DynamicResource Track}" Padding="14,10" Margin="0,6,0,0"
                                MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="QuizFeedbackText" Style="{StaticResource Body}"/>
                        </Border>
                        <Button x:Name="QuizNext" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Visibility="Collapsed" Click="OnQuizNext"/>
                    </StackPanel>

                    <StackPanel x:Name="QuizResultPanel" Visibility="Collapsed">
                        <StackPanel.RenderTransform><ScaleTransform x:Name="QuizResultScale"/></StackPanel.RenderTransform>
                        <TextBlock x:Name="QuizScoreText" Style="{StaticResource BigValue}" FontSize="38"/>
                        <TextBlock x:Name="QuizResultMsg" Style="{StaticResource Body}" Margin="0,4,0,14" MaxWidth="640" HorizontalAlignment="Left"/>
                        <Button Content="Refazer o quiz" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnQuizRestart"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Glossário ===== -->
            <TextBlock Text="Glossário" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Todas as palavras técnicas que aparecem no app, explicadas em uma ou duas frases. Digite para buscar ou filtre por tema."
                       Style="{StaticResource SectionHint}"/>
            <TextBox x:Name="GlossarySearch" Style="{StaticResource SearchBox}" Tag="Buscar um termo (ex.: VRAM, throttling, 1% low)"
                     MaxWidth="520" HorizontalAlignment="Left" MinWidth="360" Margin="0,0,0,10" TextChanged="OnGlossarySearch"/>
            <DockPanel Margin="0,0,14,12">
                <TextBlock x:Name="GlossaryCount" DockPanel.Dock="Right" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                <WrapPanel x:Name="GlossaryFilters"/>
            </DockPanel>
            <TextBlock x:Name="GlossaryEmpty" Style="{StaticResource Dim}" Visibility="Collapsed" Margin="0,4,0,14"
                       Text="Nenhum termo encontrado. Tente outra palavra ou escolha o tema &quot;Todos&quot;."/>
            <WrapPanel x:Name="GlossaryPanel"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
