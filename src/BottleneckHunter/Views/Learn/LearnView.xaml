<UserControl x:Class="BottleneckHunter.Views.Learn.LearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- ===== Estilos do módulo ===== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,18,0,2"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="Margin" Value="0,0,14,12"/>
        </Style>
        <Style x:Key="ArtLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Botão de assunto: cartão pequeno que acende quando escolhido -->
        <Style x:Key="TopicChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="12" Padding="14,9" BorderThickness="1"
                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controle deslizante do laboratório (a cor vem de Foreground) -->
        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="20" Height="20" Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LabSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPart}" Background="{TemplateBinding Foreground}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPart}" Background="{DynamicResource Track}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}" Background="{TemplateBinding Foreground}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de busca com texto de exemplo (vem do Tag) -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="10" Padding="12,9" BorderThickness="1"
                                Background="{DynamicResource Track}" BorderBrush="{DynamicResource Border}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Grid>
                                    <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource TextDim}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alternativa do quiz -->
        <Style x:Key="QuizOption" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Padding="16,11" BorderThickness="1.5"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Animações das ilustrações (uma por assunto, iniciadas pelo código) ===== -->

        <Storyboard x:Key="Anim_gargalo">
            <DoubleAnimation Storyboard.TargetName="GargCrowdA" Storyboard.TargetProperty="X" From="-2" To="2" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="GargCrowdB" Storyboard.TargetProperty="X" From="2" To="-2" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="GargRing" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDrop1" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="112"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDropE1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDrop2" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:0.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="112"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDropE2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDrop3" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="112"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GargDropE3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Anim_cpu">
            <DoubleAnimation Storyboard.TargetName="CpuCore1" Storyboard.TargetProperty="Opacity" From="0.75" To="1" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="CpuCore2" Storyboard.TargetProperty="Opacity" From="0.08" To="0.5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CpuCore3" Storyboard.TargetProperty="Opacity" From="0.08" To="0.4" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="CpuCore4" Storyboard.TargetProperty="Opacity" From="0.08" To="0.45" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.8"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CpuPkt1" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="58"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="58"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CpuPktE1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CpuPkt2" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:0.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="58"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="58"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CpuPktE2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Anim_gpu">
            <DoubleAnimation Storyboard.TargetName="GpuFan1" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="GpuFan2" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GpuCover" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GpuScan" Storyboard.TargetProperty="Y" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="46"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GpuScanLine" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Anim_ram">
            <!-- Três pacotes sobem da RAM para a CPU e um volta -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt1" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="95"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="95"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt1" Storyboard.TargetProperty="Y" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-46"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-46"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPktE1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamChip1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt2" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:0.4">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-19"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-19"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt2" Storyboard.TargetProperty="Y" RepeatBehavior="Forever" BeginTime="0:0:0.4">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-46"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-46"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPktE2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.4">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamChip4" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.4">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt3" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-95"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-95"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt3" Storyboard.TargetProperty="Y" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-46"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-46"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPktE3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamChip6" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt4" Storyboard.TargetProperty="X" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="-19"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-19"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPkt4" Storyboard.TargetProperty="Y" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="48"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="48"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RamPktE4" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- VRAM: enche, fica vermelha, transborda para a RAM e esvazia (ciclo de 6 s) -->
        <Storyboard x:Key="Anim_vram" Duration="0:0:6" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="VramPkt" Storyboard.TargetProperty="X" From="0" To="12" Duration="0:0:0.4" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramFill" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:5.4" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:6" Value="0.15"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramDanger" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0.85"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.4" Value="0.85"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOver1" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="48"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOver1" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="52"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOverE1" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:3.9" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOver2" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.8" Value="48"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOver2" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.8" Value="52"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramOverE2" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4.7" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VramWarn" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.1" Value="0.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="0.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.2" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:5.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Disco: HD carrega devagar, SSD termina num instante (ciclo de 6 s) -->
        <Storyboard x:Key="Anim_disco" Duration="0:0:6" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HdSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="HdArm" Storyboard.TargetProperty="Angle" From="-8" To="10" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SsdFlash" Storyboard.TargetProperty="Opacity" From="0" To="0.6" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="0:0:0.8"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HdBar" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SsdBar" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SsdDone" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HdDone" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.7" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Temperatura: sobe, a CPU baixa o clock (throttling) e esfria de novo (ciclo de 6 s) -->
        <Storyboard x:Key="Anim_temperatura" Duration="0:0:6" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TempFill" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25"/>
                <EasingDoubleKeyFrame KeyTime="0:0:3.4" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:4.6" Value="0.92"/>
                <EasingDoubleKeyFrame KeyTime="0:0:6" Value="0.25"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TempHot" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.4" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4.8" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TempFast" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.4" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.7" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TempSlow" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.4" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.7" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TempWarn" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.0" Value="0.4"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.3" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.8" Value="0.4"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:5.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:5.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="TempWave1" Storyboard.TargetProperty="Y" From="0" To="-14" Duration="0:0:1.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="TempWave2" Storyboard.TargetProperty="Y" From="0" To="-14" Duration="0:0:1.2" RepeatBehavior="Forever" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="TempWave3" Storyboard.TargetProperty="Y" From="0" To="-14" Duration="0:0:1.2" RepeatBehavior="Forever" BeginTime="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="TempWaveE1" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="TempWaveE2" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.2" RepeatBehavior="Forever" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="TempWaveE3" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.2" RepeatBehavior="Forever" BeginTime="0:0:0.8"/>
        </Storyboard>

        <Storyboard x:Key="Anim_fps">
            <DoubleAnimation Storyboard.TargetName="FilmMove" Storyboard.TargetProperty="X" From="0" To="-52" Duration="0:0:0.35" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="FpsScan" Storyboard.TargetProperty="X" From="0" To="258" Duration="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="FpsSpike" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

