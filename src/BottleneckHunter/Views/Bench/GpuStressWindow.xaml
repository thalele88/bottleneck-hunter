<Window x:Class="BottleneckHunter.Views.Bench.GpuStressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teste da placa de vídeo · Bottleneck Hunter"
        Width="1120" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de números (o Direct3D desenha embaixo dela, numa área separada) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Parar  (Esc)" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OnStop"/>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="QUADROS POR SEGUNDO" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="FpsText" Text="—" Style="{StaticResource StatValue}" Foreground="{DynamicResource Gpu}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="TEMPO" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TimeText" Text="0:00" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="TEMPERATURA" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TempText" Text="—" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="USO DA GPU" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="LoadText" Text="—" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="CONSUMO" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="PowerText" Text="—" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Text="Preparando a placa de vídeo..."/>
                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="{DynamicResource Track}" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <Grid x:Name="HostArea" Background="Black"/>
    </DockPanel>
</Window>
