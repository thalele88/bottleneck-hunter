<Window x:Class="BottleneckHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bottleneck Hunter" Icon="Assets/app.ico" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Menu lateral ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,18" x:Name="Logo">
                    <Grid Width="38" Height="38">
                        <Ellipse Fill="{DynamicResource AccentSoft}"/>
                        <Ellipse x:Name="LogoRing" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Margin="5"
                                 StrokeDashArray="10 4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Fill="{DynamicResource Accent}" Width="8" Height="8"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BOTTLENECK" FontWeight="Black" FontSize="15" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="HUNTER" FontWeight="Black" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,-3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: leitura ao vivo -->
                <Border DockPanel.Dock="Bottom" Margin="14" Padding="14,12" CornerRadius="12" Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{DynamicResource Good}" VerticalAlignment="Center"/>
                            <TextBlock Text="AO VIVO" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource Cpu}" FontWeight="Bold"/>
                                <TextBlock x:Name="FootCpu" Text="—" FontSize="13" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GPU" FontSize="11" Foreground="{DynamicResource Gpu}" FontWeight="Bold"/>
                                <TextBlock x:Name="FootGpu" Text="—" FontSize="13" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer>
                    <StackPanel x:Name="NavPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título própria -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeBtn" Click="OnToggleTheme" ToolTip="Alternar tema claro/escuro" Style="{StaticResource ChromeButton}" Content="&#xE793;"/>
                    <Button Click="OnMinimize" Style="{StaticResource ChromeButton}" Content="&#xE921;"/>
                    <Button Click="OnMaximize" Style="{StaticResource ChromeButton}" Content="&#xE922;"/>
                    <Button Click="OnClose" Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Tag="close"/>
                </StackPanel>
                <TextBlock x:Name="AdminBadge" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="12" Foreground="{DynamicResource TextDim}"/>
            </DockPanel>

            <!-- Página atual, com transição animada -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
